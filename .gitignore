# Playwright MCP server runtime logs
.playwright-mcp/

# Generated artifacts — regenerated by `npm run build` from
# src/content/blog/*.mdx via scripts/generate-blog-rss.mjs. Tracking it
# meant every build polluted git status with a lastBuildDate timestamp
# change. Cloudflare Pages build regenerates it from source on deploy,
# so source-of-truth stays in src/content/blog/. (Drained 2026-05-19.)
public/blog/rss.xml

# Claude Code session runtime artifacts (per-worktree scheduling locks
# and similar ephemeral state).
.claude/scheduled_tasks.lock
