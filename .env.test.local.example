# E35.2 — integration test env (NOT checked into git).
#
# Copy to `.env.test.local` and fill from `supabase status` after
# `supabase start`. Used by `npm run test:integration`.

SUPABASE_URL=http://127.0.0.1:54321

# Public anon key from `supabase status`. Same shape as VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=

# Service-role JWT from `supabase status`. NEVER commit. NEVER ship in
# client bundles. Used only by the integration test harness to seed
# fixture rows that anon clients then probe.
SUPABASE_SERVICE_ROLE_TEST_KEY=
