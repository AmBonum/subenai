# Copy this file to `.env` and fill in your own Supabase project values.
# Get these from: Supabase dashboard → Settings → API
#
# All variables prefixed with VITE_ are exposed to the browser bundle.
# The Supabase `anon` (publishable) key is designed to be public — Row Level
# Security policies on the database enforce access control. NEVER put the
# `service_role` key here.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon (publishable) key — the long JWT starting with eyJ...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Project ref — the part of the URL before .supabase.co
VITE_SUPABASE_PROJECT_ID=

# --- Cloudflare Turnstile (E11.4 portal magic link bot challenge) ---------
# Public site key — safe to ship in the client bundle.
# Get from https://dash.cloudflare.com → Turnstile → Add site → copy "Site Key".
# Use the test key "1x00000000000000000000AA" for local dev (always passes).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- AH-4.1 AI generator (admin questions composer) -----------------------
# Optional. When "true", the /admin/questions UI shows the AI-generate
# button. Default "false" (UI hidden). The actual generation happens in a
# CF Pages function — flipping this flag client-side without the server
# wiring still calls the endpoint, which will 503 if unconfigured.
VITE_AI_GENERATOR_ENABLED=false

# --- E36 dev-only sign-in helper -------------------------------------------
# Optional. When set AND running in Vite dev mode, the /login page shows a
# yellow "DEV E36 audit helper" panel with a one-click "Prihlásiť ako
# test user" button. Used during the /app audit so the agent can navigate
# every authenticated surface without manually typing credentials each
# session. The DEV check tree-shakes the entire panel out of production
# builds; the VITE_DEV_* values themselves are inlined at build time so
# leaving them unset in production .env hides the button anyway.
VITE_DEV_TEST_USER_EMAIL=
VITE_DEV_TEST_USER_PASSWORD=

# --- Production-only (DO NOT put here) ------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is the master key that bypasses every RLS
# policy. It must NEVER live in `.env` or the client bundle. Set it
# directly in Cloudflare Pages → Settings → Variables and Secrets
# (Production) so it is only readable by Pages Functions at runtime.
