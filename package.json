{
  "name": "subenai",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8080",
    "dev:api": "npm run build && wrangler pages dev dist/client --compatibility-date=2024-09-01 --port 8788",
    "dev:cf": "npm run build && wrangler pages dev dist/client --compatibility-date=2024-09-01 --port 8788",
    "dev:stripe": "./scripts/dev-stripe.sh",
    "build": "node scripts/parse-changelog.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-blog-rss.mjs && node scripts/generate-og-default.mjs && vite build && node scripts/extract-csp-hashes.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "blog-rss": "node scripts/generate-blog-rss.mjs",
    "og-default": "node scripts/generate-og-default.mjs",
    "seed-blog": "node scripts/seed-blog-posts.mjs",
    "changelog": "node scripts/parse-changelog.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --port 8080",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:all": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "retention:dry-run": "DRY_RUN=1 node scripts/run-retention.mjs",
    "e2e": "playwright test",
    "e2e:full": "E2E_SERVERS=1 playwright test --project=e2e-chromium",
    "e2e:integration": "playwright test --project=integration",
    "e2e:browser": "playwright test --project=e2e-chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --project=e2e-chromium --headed",
    "e2e:report": "playwright show-report",
    "e2e:stripe": "STRIPE_E2E_BASE_URL=http://localhost:8788 playwright test e2e/integration/webhooks e2e/specs/sponsorship",
    "perf": "node scripts/perf-run.mjs",
    "perf:report": "node scripts/perf-report.mjs",
    "perf:view": "gunzip -c reports/perf-latest.md.gz",
    "load": "node scripts/load-test.mjs",
    "audit:bundle": "scripts/check-bundle-no-trackers.sh dist",
    "check:bundle-no-mocks": "node scripts/check-bundle-no-mocks.mjs",
    "check:bundle-no-secrets": "node scripts/check-bundle-no-secrets.mjs",
    "db:verify:staging": "ENV_FILE=.env.staging bash scripts/verify-supabase-migration.sh",
    "db:verify:prod": "ENV_FILE=.env.prod bash scripts/verify-supabase-migration.sh"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.104.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.14",
    "@tanstack/router-plugin": "^1.167.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^1.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.2",
    "prettier": "^3.7.3",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
